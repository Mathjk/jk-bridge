<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:JKBridge.App.ViewModels"
        x:Class="JKBridge.App.Views.LogWindow"
        x:DataType="vm:LogWindowViewModel"
        Title="{Binding Title}"
        Width="860" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource JkWindowBrush}">
    <Grid Margin="16" RowDefinitions="Auto,*,Auto">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
            <TextBlock Text="{Binding Title}" Classes="section-title" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" SelectedIndex="{Binding LineCountIndex}"
                      Width="110" VerticalAlignment="Center">
                <ComboBoxItem Content="100 行" />
                <ComboBoxItem Content="300 行" />
                <ComboBoxItem Content="500 行" />
            </ComboBox>
            <Button Grid.Column="2" Content="刷新" Classes="ghost" Margin="8,0,0,0"
                    Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}" />
            <Button Grid.Column="3" Content="关闭" Classes="ghost" Margin="8,0,0,0"
                    Command="{Binding CloseCommand}" />
        </Grid>
        <Border Grid.Row="1" Classes="card" Margin="0,10,0,10" Padding="4">
            <TextBox Text="{Binding LogText}" Classes="field technical"
                     IsReadOnly="True" TextWrapping="NoWrap"
                     AcceptsReturn="True" BorderThickness="0"
                     FontFamily="{DynamicResource JkTechnicalFontFamily}"
                     FontSize="12" />
        </Border>
        <TextBlock Grid.Row="2" Text="{Binding Feedback}" Classes="caption" />
    </Grid>
</Window>
