<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:JKBridge.App.ViewModels"
        xmlns:pages="using:JKBridge.App.Views.Pages"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1120"
        d:DesignHeight="760"
        x:Class="JKBridge.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Classes="jk-root"
        Icon="/Assets/jkbridge.ico"
        Title="JK Bridge — 本地服务桥"
        Width="1120"
        Height="760"
        MinWidth="980"
        MinHeight="680"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid>
        <Grid ColumnDefinitions="232,*">
            <Border Grid.Column="0" Classes="nav-pane">
                <Grid RowDefinitions="48,20,*,Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="7,2,6,0">
                        <Border Width="42" Height="42" CornerRadius="10">
                            <Image Source="/Assets/app-icon.png"
                                   Width="42" Height="42" Stretch="Uniform"
                                   AutomationProperties.Name="JK Bridge 标志" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="11,1,0,0">
                            <TextBlock Text="JK Bridge" Classes="body-strong" FontSize="15" />
                            <TextBlock Text="LOCAL SERVICES" Classes="eyebrow" Margin="0,1,0,0" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2">
                        <TextBlock Text="日常使用" Classes="eyebrow" Margin="12,0,0,8" />
                        <ToggleButton Classes="nav-item"
                                      IsChecked="{Binding IsOverview}"
                                      Command="{Binding ShowOverviewCommand}"
                                      ToolTip.Tip="连接、断开并查看所有服务状态"
                                      AutomationProperties.Name="概览">
                            <Grid ColumnDefinitions="28,*">
                                <TextBlock Text="01" Classes="technical-strong" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="概览" VerticalAlignment="Center" />
                            </Grid>
                        </ToggleButton>
                        <ToggleButton Classes="nav-item"
                                      IsChecked="{Binding IsServices}"
                                      Command="{Binding ShowServicesCommand}"
                                      ToolTip.Tip="管理 Linux 隧道与 Windows 本机服务"
                                      AutomationProperties.Name="服务">
                            <Grid ColumnDefinitions="28,*">
                                <TextBlock Text="02" Classes="technical-strong" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="服务" VerticalAlignment="Center" />
                            </Grid>
                        </ToggleButton>

                        <TextBlock Text="配置与维护" Classes="eyebrow" Margin="12,17,0,8" />
                        <ToggleButton Classes="nav-item"
                                      IsChecked="{Binding IsSetup}"
                                      Command="{Binding ShowSetupCommand}"
                                      ToolTip.Tip="首次配对与设备配置 高级管理"
                                      AutomationProperties.Name="设备配置">
                            <Grid ColumnDefinitions="28,*">
                                <TextBlock Text="03" Classes="technical-strong" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="设备配置" VerticalAlignment="Center" />
                            </Grid>
                        </ToggleButton>
                        <ToggleButton Classes="nav-item"
                                      IsChecked="{Binding IsDiagnostics}"
                                      Command="{Binding ShowDiagnosticsCommand}"
                                      ToolTip.Tip="连接打不开时逐段检查并查看日志"
                                      AutomationProperties.Name="诊断">
                            <Grid ColumnDefinitions="28,*">
                                <TextBlock Text="04" Classes="technical-strong" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="诊断" VerticalAlignment="Center" />
                            </Grid>
                        </ToggleButton>
                    </StackPanel>

                    <StackPanel Grid.Row="3">
                        <Border Classes="card" Padding="12" Margin="0,0,0,10">
                            <Grid ColumnDefinitions="Auto,*">
                                <Grid Width="9" Height="9" VerticalAlignment="Center">
                                    <Border CornerRadius="5" Background="{DynamicResource JkNeutralBrush}"
                                            IsVisible="{Binding IsStopped}" />
                                    <Border CornerRadius="5" Background="{DynamicResource JkIrisBrush}"
                                            IsVisible="{Binding IsConnecting}" />
                                    <Border CornerRadius="5" Background="{DynamicResource JkWarningBrush}"
                                            IsVisible="{Binding IsDegraded}" />
                                    <Border CornerRadius="5" Background="{DynamicResource JkSuccessBrush}"
                                            IsVisible="{Binding IsConnected}" />
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding ConnectionStatus}" Classes="body-strong" />
                                    <TextBlock Text="{Binding AvailableServicesText}" Classes="caption" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock Text="帮助与偏好" Classes="eyebrow" Margin="12,0,0,6" />
                        <Button Classes="nav-item"
                                Command="{Binding ShowWelcomeTutorialCommand}"
                                ToolTip.Tip="重新打开四步使用教程"
                                AutomationProperties.Name="使用指南">
                            <Grid ColumnDefinitions="28,*">
                                <TextBlock Text="?" Classes="technical-strong" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="使用指南" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <ToggleButton Classes="nav-item"
                                      IsChecked="{Binding IsSettings}"
                                      Command="{Binding ShowSettingsCommand}"
                                      ToolTip.Tip="连接偏好、外观、版本更新与关于"
                                      AutomationProperties.Name="设置">
                            <Grid ColumnDefinitions="28,*">
                                <TextBlock Text="••" Classes="technical-strong" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="设置" VerticalAlignment="Center" />
                            </Grid>
                        </ToggleButton>
                        <TextBlock Text="{Binding ApplicationFooterText}" Classes="caption" Margin="12,8,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <pages:SetupPage IsVisible="{Binding IsSetup}" />
                <pages:OverviewPage IsVisible="{Binding IsOverview}" />
                <pages:ServicesPage IsVisible="{Binding IsServices}" />
                <pages:DiagnosticsPage IsVisible="{Binding IsDiagnostics}" />
                <pages:SettingsPage IsVisible="{Binding IsSettings}" />
            </Grid>
        </Grid>

        <Border Background="{DynamicResource JkScrimBrush}"
                IsVisible="{Binding IsWelcomeTutorialVisible}"
                AutomationProperties.Name="JK Bridge 使用教程">
            <Border Width="720"
                    MaxHeight="650"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource JkSurfaceBrush}"
                    BorderBrush="{DynamicResource JkBorderStrongBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    BoxShadow="0 18 54 0 #4A000000">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Border Background="{DynamicResource JkIrisSurfaceBrush}"
                            BorderBrush="{DynamicResource JkIrisBorderBrush}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="12,12,0,0"
                            Padding="28,22">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Text="{Binding WelcomeTutorialStep.Eyebrow}"
                                           Classes="eyebrow" />
                                <TextBlock Text="{Binding WelcomeTutorialStep.Title}"
                                           Classes="page-title"
                                           FontSize="25"
                                           TextWrapping="Wrap"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Classes="code-chip"
                                    VerticalAlignment="Top" Margin="18,0,0,0">
                                <TextBlock Text="{Binding WelcomeTutorialProgressText}"
                                           Classes="technical-strong" />
                            </Border>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="28,24,28,20">
                            <TextBlock Text="{Binding WelcomeTutorialStep.Description}"
                                       Classes="page-subtitle"
                                       FontSize="15"
                                       LineHeight="23"
                                       TextWrapping="Wrap" />

                            <Grid ColumnDefinitions="*,14,*,14,*" Margin="0,22,0,0">
                                <Border Grid.Column="0" Classes="card" Padding="15">
                                    <StackPanel>
                                        <TextBlock Text="01" Classes="technical-strong" />
                                        <TextBlock Text="{Binding WelcomeTutorialStep.FirstTitle}"
                                                   Classes="card-title" Margin="0,7,0,0"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding WelcomeTutorialStep.FirstDetail}"
                                                   Classes="caption" Margin="0,5,0,0"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Classes="card" Padding="15">
                                    <StackPanel>
                                        <TextBlock Text="02" Classes="technical-strong" />
                                        <TextBlock Text="{Binding WelcomeTutorialStep.SecondTitle}"
                                                   Classes="card-title" Margin="0,7,0,0"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding WelcomeTutorialStep.SecondDetail}"
                                                   Classes="caption" Margin="0,5,0,0"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="4" Classes="card" Padding="15">
                                    <StackPanel>
                                        <TextBlock Text="03" Classes="technical-strong" />
                                        <TextBlock Text="{Binding WelcomeTutorialStep.ThirdTitle}"
                                                   Classes="card-title" Margin="0,7,0,0"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding WelcomeTutorialStep.ThirdDetail}"
                                                   Classes="caption" Margin="0,5,0,0"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Classes="issue-banner info" Margin="0,18,0,0">
                                <TextBlock Text="{Binding WelcomeTutorialStep.Note}"
                                           Classes="body" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2"
                            BorderBrush="{DynamicResource JkBorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="22,16">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center">
                                <Button Content="以后再看"
                                        Classes="ghost"
                                        HorizontalAlignment="Left"
                                        Command="{Binding DismissWelcomeTutorialCommand}" />
                                <TextBlock Text="{Binding WelcomeTutorialFeedback}"
                                           Classes="caption"
                                           Margin="2,4,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        Spacing="8" VerticalAlignment="Center">
                                <Button Content="上一步"
                                        Classes="secondary"
                                        IsVisible="{Binding !IsFirstWelcomeTutorialStep}"
                                        IsEnabled="{Binding CanAdvanceWelcomeTutorial}"
                                        Command="{Binding PreviousWelcomeTutorialCommand}" />
                                <Button Content="{Binding WelcomeTutorialNextButtonText}"
                                        Classes="primary"
                                        MinWidth="96"
                                        IsEnabled="{Binding CanAdvanceWelcomeTutorial}"
                                        Command="{Binding AdvanceWelcomeTutorialCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Border>
    </Grid>

</Window>
