<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:JKBridge.App.ViewModels"
        x:Class="JKBridge.App.Views.ConfirmDialogWindow"
        x:DataType="vm:ConfirmDialogViewModel"
        Title="{Binding Title}"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        SystemDecorations="None"
        Background="{DynamicResource JkWindowBrush}">
    <Border Classes="card" Padding="22" Margin="16">
        <StackPanel>
            <TextBlock Text="{Binding Title}" Classes="section-title" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Message}" Classes="body"
                       Margin="0,10,0,0" TextWrapping="Wrap" />
            <Border Classes="issue-banner warning"
                    IsVisible="{Binding IsDangerous}"
                    Margin="0,12,0,0" Padding="12,10">
                <TextBlock Text="这是一个会影响服务可用性的操作，请确认当前没有正在依赖它的任务。"
                           Classes="caption" TextWrapping="Wrap" />
            </Border>
            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,18,0,0">
                <Button Grid.Column="1" Content="{Binding CancelText}" Classes="ghost"
                        Command="{Binding CancelCommand}" MinWidth="88" />
                <Button Grid.Column="2" Content="{Binding ConfirmText}"
                        Classes="primary" Margin="8,0,0,0"
                        Command="{Binding ConfirmCommand}" MinWidth="88" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
