<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:JKBridge.App.ViewModels"
             xmlns:pages="using:JKBridge.App.Views.Pages"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="888"
             d:DesignHeight="760"
             x:Name="ServicesRoot"
             x:Class="JKBridge.App.Views.Pages.ServicesPage"
             x:DataType="vm:MainViewModel">
    <Border Classes="page-surface">
        <Grid RowDefinitions="Auto,22,*">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Text="服务" Classes="page-title" />
                    <TextBlock Text="先选择“Linux 隧道”或“Windows 本机”，再添加、扫描、保存和打开对应服务。"
                               Classes="page-subtitle" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <Button Content="Linux 隧道" Classes="ghost"
                            Classes.primary="{Binding IsLinuxServicesMode}"
                            Command="{Binding ShowLinuxServicesCommand}" />
                    <Button Content="Windows 本机" Classes="ghost"
                            Classes.primary="{Binding IsWindowsLocalServicesMode}"
                            Command="{Binding ShowWindowsLocalServicesCommand}" />
                    <Button Content="＋ 添加转发" Classes="primary"
                            IsVisible="{Binding IsLinuxServicesMode}"
                            Command="{Binding AddServiceCommand}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2"
                  ColumnDefinitions="1.08*,18,0.92*"
                  IsVisible="{Binding IsLinuxServicesMode}">
                <Grid Grid.Column="0" RowDefinitions="Auto,12,Auto,12,*">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="转发清单" Classes="section-title" />
                        <Border Grid.Column="1" Classes="status-pill connected" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AvailableServicesText}" Classes="status-text connected" />
                        </Border>
                    </Grid>
                    <Expander Grid.Row="2" Header="Linux 待添加服务（Agent）"
                              IsExpanded="False">
                        <Border Classes="card" Padding="14" Margin="0,0,0,2">
                            <StackPanel>
                                <TextBlock Text="只读取 Linux 当前 127.0.0.1 监听并做有限网页识别；不扫磁盘、不遍历端口，也不会自动保存或授权。"
                                           Classes="caption" TextWrapping="Wrap" />
                                <TextBlock Text="粘贴 Linux 本机网址" Classes="body-strong" Margin="0,9,0,5" />
                                <Grid ColumnDefinitions="*,8,Auto">
                                    <TextBox Text="{Binding LinuxQuickAddUrl}" Classes="field technical"
                                             PlaceholderText="http://127.0.0.1:8384/ 或 localhost" />
                                    <Button Grid.Column="2" Content="加入草稿" Classes="secondary"
                                            IsEnabled="{Binding CanAddLinuxUrlDraft}"
                                            Command="{Binding AddLinuxUrlDraftCommand}" />
                                </Grid>
                                <TextBlock Text="{Binding LinuxQuickAddFeedback}"
                                           Classes="caption" TextWrapping="Wrap" Margin="0,5,0,0" />
                                <Separator Classes="quiet" Margin="0,10,0,8" />
                                <Button Content="扫描 Linux 当前服务" Classes="secondary"
                                        HorizontalAlignment="Left" Margin="0,9,0,0"
                                        IsEnabled="{Binding CanScanLinuxPendingServices}"
                                        Command="{Binding ScanLinuxPendingServicesCommand}" />
                                <TextBlock Text="{Binding LinuxPendingServiceFeedback}"
                                           Classes="caption" TextWrapping="Wrap" Margin="0,7,0,0" />
                                <ComboBox ItemsSource="{Binding LinuxPendingServices}"
                                          SelectedItem="{Binding SelectedLinuxPendingService}"
                                          IsVisible="{Binding HasLinuxPendingServices}"
                                          Margin="0,9,0,0"
                                          PlaceholderText="选择一个待确认服务">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:LinuxPendingServiceUiState">
                                            <TextBlock Text="{Binding DisplayText}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Content="加入为停用服务草稿" Classes="secondary"
                                        HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                        IsVisible="{Binding HasLinuxPendingServices}"
                                        IsEnabled="{Binding CanAddSelectedLinuxPendingService}"
                                        Command="{Binding AddSelectedLinuxPendingServiceCommand}" />
                                <TextBlock Text="加入后先在右侧复核并保存；如使用 Agent，还需到“设备配置 → Agent 管理”只读预览授权差异并明确确认。"
                                           Classes="caption" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </Expander>

                    <ListBox Grid.Row="4"
                             ItemsSource="{Binding Services}"
                             SelectedItem="{Binding SelectedService}"
                             Classes="service-list">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ServiceCardViewModel">
                                <Border Classes="card interactive" Padding="14" Margin="0,0,0,10">
                                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                                        <Border Grid.RowSpan="2" Width="38" Height="38" CornerRadius="8"
                                                Background="{DynamicResource JkIrisSurfaceBrush}"
                                                BorderBrush="{DynamicResource JkIrisBorderBrush}"
                                                BorderThickness="1">
                                            <TextBlock Text="{Binding ShortCode}" Classes="technical-strong"
                                                       Foreground="{DynamicResource JkIrisBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,-1,12,0">
                                            <TextBlock Text="{Binding Name}" Classes="body-strong" />
                                            <TextBlock Text="{Binding PortMapping}" Classes="technical" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Classes="status-pill"
                                                Classes.connected="{Binding IsAvailable}"
                                                Classes.warning="{Binding HasWarning}">
                                            <TextBlock Text="{Binding Status}" Classes="status-text"
                                                       Classes.connected="{Binding IsAvailable}"
                                                       Classes.warning="{Binding HasWarning}" />
                                        </Border>
                                        <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                              ColumnDefinitions="*,Auto,Auto,Auto" Margin="12,10,0,0">
                                            <TextBlock Text="{Binding BrowserUrlPreview}" Classes="caption"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Button Grid.Column="1" Content="检查" Classes="ghost" Command="{Binding RetryCommand}" />
                                            <Button Grid.Column="2" Content="{Binding RestartButtonText}" Classes="ghost"
                                                    Command="{Binding RestartCommand}"
                                                    IsVisible="{Binding HasRestartAction}"
                                                    IsEnabled="{Binding !IsRestarting}" />
                                            <Button Grid.Column="3" Content="打开 ↗" Classes="ghost" Command="{Binding OpenCommand}"
                                                    IsEnabled="{Binding CanOpen}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <Border Grid.Column="2" Classes="card" Padding="20"
                        DataContext="{Binding SelectedService}"
                        x:DataType="vm:ServiceCardViewModel">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="编辑转发" Classes="section-title" />
                            <TextBlock Text="Windows 入口和 Linux 服务端口可以不同；保存后活动隧道会安全重连。"
                                       Classes="page-subtitle" Margin="0,2,0,14" TextWrapping="Wrap" />

                            <Border Classes="bridge-rail" Padding="14,12" Margin="0,0,0,16">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="实时转发路径" Classes="eyebrow" />
                                    <TextBlock Text="{Binding RoutePreview}" Classes="technical-strong"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="浏览器或软件只连接 Windows 本机，JK Bridge 再经 SSH + Tailscale 访问 Linux。"
                                               Classes="caption" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Classes="card" Padding="12" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="从模板填写" Classes="body-strong" />
                                    <TextBlock Text="选择只显示预览；确认并点击应用后才会覆盖当前草稿，且仍需另行保存。"
                                               Classes="caption" Margin="0,2,0,7" TextWrapping="Wrap" />
                                    <ComboBox ItemsSource="{Binding ServiceTemplates}"
                                              SelectedItem="{Binding SelectedTemplate}"
                                              Classes="field" PlaceholderText="选择 Overleaf、Sub2API 或通用模板">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ServiceTemplateOptionViewModel">
                                                <StackPanel Margin="0,3">
                                                    <TextBlock Text="{Binding DisplayName}" Classes="body-strong" />
                                                    <TextBlock Text="{Binding Summary}" Classes="caption" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0"
                                          IsVisible="{Binding HasSelectedTemplate}">
                                        <StackPanel>
                                            <Grid ColumnDefinitions="Auto,*">
                                                <ToggleSwitch IsChecked="{Binding TemplateApplyConfirmed}" />
                                                <TextBlock Grid.Column="1" Text="确认覆盖当前未保存草稿"
                                                           Classes="body" Margin="8,0,0,0"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Text="{Binding TemplateApplyFeedback}" Classes="caption"
                                                       Margin="0,3,10,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="应用到草稿" Classes="ghost"
                                                Command="{Binding ApplySelectedTemplateCommand}"
                                                IsEnabled="{Binding CanApplySelectedTemplate}"
                                                VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="服务名称" Classes="body-strong" Margin="0,0,0,6" />
                            <TextBox Text="{Binding Name}" Classes="field" PlaceholderText="例如 Overleaf" />

                            <TextBlock Text="说明" Classes="body-strong" Margin="0,14,0,6" />
                            <TextBox Text="{Binding Description}" Classes="field" PlaceholderText="这项服务做什么" />

                            <Grid ColumnDefinitions="*,14,*" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="Windows 访问端口" Classes="body-strong" Margin="0,0,0,6" />
                                    <TextBox Text="{Binding LocalPortText}" Classes="field technical" />
                                    <TextBlock Text="浏览器和软件在这台 Windows 上使用"
                                               Classes="caption" Margin="0,5,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Linux 服务端口" Classes="body-strong" Margin="0,0,0,6" />
                                    <TextBox Text="{Binding RemotePortText}" Classes="field technical" />
                                    <TextBlock Text="最终连接 Linux 的 127.0.0.1 端口"
                                               Classes="caption" Margin="0,5,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>

                            <Border Classes="issue-banner"
                                    Classes.warning="{Binding HasLocalPortConflict}"
                                    Margin="0,10,0,0" Padding="12,10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel>
                                        <TextBlock Text="Windows 端口检查" Classes="body-strong" />
                                        <TextBlock Text="{Binding LocalPortAvailabilityHint}" Classes="caption"
                                                   Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{Binding SuggestedLocalPortText}"
                                            Classes="ghost" Command="{Binding ApplySuggestedLocalPortCommand}"
                                            IsVisible="{Binding HasSuggestedLocalPort}"
                                            VerticalAlignment="Center" Margin="10,0,0,0" />
                                </Grid>
                            </Border>

                            <Grid ColumnDefinitions="0.42*,14,*" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="访问协议" Classes="body-strong" Margin="0,0,0,6" />
                                    <ComboBox SelectedIndex="{Binding ProtocolIndex}" Classes="field"
                                              IsEnabled="{Binding UsesGeneratedUrl}">
                                        <ComboBoxItem Content="HTTP" />
                                        <ComboBoxItem Content="HTTPS" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="打开路径" Classes="body-strong" Margin="0,0,0,6" />
                                    <TextBox Text="{Binding LaunchPath}" Classes="field technical"
                                             IsEnabled="{Binding UsesGeneratedUrl}"
                                             PlaceholderText="例如 /project 或 /#/login" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="打开网址预览" Classes="body-strong" Margin="0,14,0,6" />
                            <Border Classes="code-chip" Padding="10,8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding BrowserUrlPreview}" Classes="technical-strong"
                                               VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <Button Grid.Column="1" Content="复制" Classes="ghost"
                                            Command="{Binding CopyAddressCommand}" Margin="8,0,0,0" />
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding BrowserUrlValidationHint}"
                                       Classes="caption" Margin="0,5,0,0" TextWrapping="Wrap" />

                            <Border Classes="issue-banner"
                                    Classes.warning="{Binding RequiresLinuxReauthorization}"
                                    Margin="0,14,0,0" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="端口授权" Classes="body-strong" />
                                    <TextBlock Text="{Binding ReauthorizationHint}" Classes="caption"
                                               Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Grid ColumnDefinitions="*,Auto" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="高级设置" Classes="body-strong" />
                                    <TextBlock Text="完整网址与健康检查；通常不需要修改"
                                               Classes="caption" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsAdvanced}"
                                              VerticalAlignment="Center" />
                            </Grid>

                            <StackPanel IsVisible="{Binding IsAdvanced}" Margin="0,12,0,0">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel>
                                        <TextBlock Text="手动设置完整网址" Classes="body-strong" />
                                        <TextBlock Text="仍只允许相同 Windows 端口上的 127.0.0.1 地址"
                                                   Classes="caption" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding UseCustomUrl}"
                                                  VerticalAlignment="Center" />
                                </Grid>
                                <TextBox Text="{Binding LocalUrl}" Classes="field technical"
                                         IsEnabled="{Binding UseCustomUrl}" Margin="0,7,0,0" />

                                <Grid ColumnDefinitions="*,Auto" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="独立健康检查路径" Classes="body-strong" />
                                        <TextBlock Text="默认从打开网址推导；查询参数和 # 片段不会发送给服务"
                                                   Classes="caption" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding UseCustomHealthPath}"
                                                  VerticalAlignment="Center" />
                                </Grid>
                                <TextBox Text="{Binding HealthPathText}" Classes="field technical"
                                         IsEnabled="{Binding UseCustomHealthPath}" Margin="0,7,0,0"
                                         PlaceholderText="例如 /api/health" />
                                <TextBlock Text="{Binding HealthPathValidationHint}"
                                           Classes="caption" Margin="0,5,0,0" TextWrapping="Wrap" />

                                <Grid ColumnDefinitions="*,Auto" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="重启操作" Classes="body-strong" />
                                        <TextBlock Text="开启后服务卡片显示重启按钮；请求经现有隧道 POST 到该路径"
                                                   Classes="caption" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding UseRestartAction}"
                                                  VerticalAlignment="Center" />
                                </Grid>
                                <TextBox Text="{Binding RestartPathText}" Classes="field technical"
                                         IsEnabled="{Binding UseRestartAction}" Margin="0,7,0,0"
                                         PlaceholderText="例如 /api/restart" />
                                <TextBlock Text="重启令牌" Classes="body-strong" Margin="0,10,0,6" />
                                <TextBox Text="{Binding RestartTokenText}" Classes="field technical"
                                         IsEnabled="{Binding UseRestartAction}" PasswordChar="•"
                                         PlaceholderText="可留空；Linux 服务未校验令牌时无需填写" />
                                <TextBlock Text="重启端口" Classes="body-strong" Margin="0,10,0,6" />
                                <TextBox Text="{Binding RestartLocalPortText}" Classes="field technical"
                                         IsEnabled="{Binding UseRestartAction}"
                                         PlaceholderText="留空 = 使用本服务的 Windows 端口" />
                                <TextBlock Text="{Binding RestartActionHint}"
                                           Classes="caption" Margin="0,5,0,0" TextWrapping="Wrap" />

                                <TextBlock Text="健康检查方式" Classes="body-strong" Margin="0,14,0,6" />
                                <ComboBox SelectedIndex="{Binding HealthModeIndex}" Classes="field">
                                    <ComboBoxItem Content="TCP 端口（适合自签名 HTTPS）" />
                                    <ComboBoxItem Content="HTTP 状态码" />
                                    <ComboBoxItem Content="JSON ok=true" />
                                </ComboBox>
                                <TextBlock Text="{Binding HealthModeExplanation}"
                                           Classes="caption" Margin="0,5,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="健康检查只用于提示，不再阻止浏览器打开已建立的转发。"
                                           Classes="caption" Margin="0,3,0,0" TextWrapping="Wrap" />

                                <Border Classes="issue-banner warning" Margin="0,10,0,0"
                                        IsVisible="{Binding IsHttps}" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="HTTPS、证书与 SNI" Classes="body-strong" />
                                        <TextBlock Text="{Binding HttpsCompatibilityHint}" Classes="caption"
                                                   Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Classes="issue-banner" Margin="0,10,0,0" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="网页跳转" Classes="body-strong" />
                                        <TextBlock Text="相对跳转仍会经过本机隧道；跳到原始 10.x 地址或原始主机名的绝对网址会绕开 127.0.0.1。JK Bridge 不会改写重定向、Cookie、CORS 或 WebSocket 地址。"
                                                   Classes="caption" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="{Binding #ServicesRoot.DataContext.ServiceFeedback}"
                                       Classes="caption" Margin="0,10,0,0" TextWrapping="Wrap" />

                            <Grid ColumnDefinitions="*,Auto" Margin="0,18,0,0">
                                <StackPanel>
                                    <TextBlock Text="启用服务" Classes="body-strong" />
                                    <TextBlock Text="参与下一次 SSH 转发" Classes="caption" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsEnabled}"
                                              VerticalAlignment="Center" />
                            </Grid>

                            <Separator Classes="quiet" />
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Button Content="删除" Classes="ghost" Foreground="{DynamicResource JkErrorBrush}"
                                        Command="{Binding RemoveCommand}" />
                                <Button Grid.Column="0" Content="查看 Linux 日志" Classes="ghost"
                                        Command="{Binding OpenLogCommand}" Margin="0,0,8,0" />
                                <Button Grid.Column="2" Content="保存更改" Classes="primary"
                                        Command="{Binding SaveCommand}" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <pages:WindowsLocalServicesPanel Grid.Row="2"
                                             IsVisible="{Binding IsWindowsLocalServicesMode}" />
        </Grid>
    </Border>
</UserControl>
