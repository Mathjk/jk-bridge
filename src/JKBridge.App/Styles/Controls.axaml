<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Reusable class styles for JK Bridge.

    Naming convention:
      layout      jk-root, page-surface, nav-pane
      components  card, service-card, bridge-rail, status-pill
      variants    connected, info, warning, error, neutral

    The controls retain Avalonia Fluent templates and accessibility behavior;
    these styles only establish JK Bridge's hierarchy, geometry, and states.
  -->

  <!-- Application shell -->
  <Style Selector="Window.jk-root">
    <Setter Property="Background" Value="{DynamicResource JkWindowBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource JkTextBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource JkUiFontFamily}" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <Style Selector="Border.page-surface">
    <Setter Property="Background" Value="{DynamicResource JkWindowBrush}" />
    <Setter Property="Padding" Value="30,26,30,30" />
  </Style>

  <Style Selector="Border.nav-pane">
    <Setter Property="Background" Value="{DynamicResource JkNavigationBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JkBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="Padding" Value="10,14,10,12" />
  </Style>

  <Style Selector="Border.drawer">
    <Setter Property="Background" Value="{DynamicResource JkSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JkBorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
    <Setter Property="Padding" Value="24" />
    <Setter Property="BoxShadow" Value="-8 0 28 0 #18000000" />
  </Style>

  <Style Selector="Border.scrim">
    <Setter Property="Background" Value="{DynamicResource JkScrimBrush}" />
  </Style>

  <!-- Type hierarchy -->
  <Style Selector="TextBlock.page-title">
    <Setter Property="FontFamily" Value="{DynamicResource JkDisplayFontFamily}" />
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="36" />
    <Setter Property="Foreground" Value="{DynamicResource JkTextBrush}" />
  </Style>

  <Style Selector="TextBlock.page-subtitle">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="Foreground" Value="{DynamicResource JkTextMutedBrush}" />
  </Style>

  <Style Selector="TextBlock.section-title">
    <Setter Property="FontFamily" Value="{DynamicResource JkDisplayFontFamily}" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="28" />
    <Setter Property="Foreground" Value="{DynamicResource JkTextBrush}" />
  </Style>

  <Style Selector="TextBlock.card-title">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="Foreground" Value="{DynamicResource JkTextBrush}" />
  </Style>

  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="Foreground" Value="{DynamicResource JkTextBrush}" />
  </Style>

  <Style Selector="TextBlock.body-strong">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="Foreground" Value="{DynamicResource JkTextBrush}" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="Foreground" Value="{DynamicResource JkTextMutedBrush}" />
  </Style>

  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource JkTextSubtleBrush}" />
  </Style>

  <Style Selector="TextBlock.eyebrow">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.8" />
    <Setter Property="Foreground" Value="{DynamicResource JkTextSubtleBrush}" />
  </Style>

  <Style Selector="TextBlock.technical">
    <Setter Property="FontFamily" Value="{DynamicResource JkTechnicalFontFamily}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="17" />
    <Setter Property="Foreground" Value="{DynamicResource JkTextMutedBrush}" />
  </Style>

  <Style Selector="TextBlock.technical-strong">
    <Setter Property="FontFamily" Value="{DynamicResource JkTechnicalFontFamily}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="17" />
    <Setter Property="Foreground" Value="{DynamicResource JkTextBrush}" />
  </Style>

  <!-- Navigation -->
  <Style Selector="ToggleButton.nav-item">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource JkTextMutedBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="ToggleButton.nav-item:pointerover">
    <Setter Property="Background" Value="{DynamicResource JkSurfaceHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource JkTextBrush}" />
  </Style>

  <Style Selector="ToggleButton.nav-item:checked">
    <Setter Property="Background" Value="{DynamicResource JkIrisSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JkIrisBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource JkIrisBrush}" />
  </Style>

  <Style Selector="ToggleButton.nav-item:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource JkFocusBrush}" />
  </Style>

  <Style Selector="Button.nav-item">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource JkTextMutedBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.nav-item:pointerover">
    <Setter Property="Background" Value="{DynamicResource JkSurfaceHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource JkTextBrush}" />
  </Style>

  <Style Selector="Button.nav-item:pressed">
    <Setter Property="Background" Value="{DynamicResource JkSurfacePressedBrush}" />
  </Style>

  <Style Selector="Button.nav-item:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource JkFocusBrush}" />
  </Style>

  <!-- Cards and content surfaces -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource JkSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JkBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="BoxShadow" Value="0 2 10 0 #0D000000" />
  </Style>

  <Style Selector="Border.card.interactive:pointerover">
    <Setter Property="Background" Value="{DynamicResource JkSurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JkBorderStrongBrush}" />
    <Setter Property="BoxShadow" Value="0 5 16 0 #14000000" />
  </Style>

  <Style Selector="Border.service-card">
    <Setter Property="MinHeight" Value="132" />
  </Style>

  <Style Selector="Border.log-surface">
    <Setter Property="Background" Value="{DynamicResource JkCodeSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JkBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="14" />
  </Style>

  <Style Selector="Border.code-chip">
    <Setter Property="Background" Value="{DynamicResource JkCodeSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JkBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="7,3" />
  </Style>

  <!-- Bridge Rail: endpoint nodes and dependency segments -->
  <Style Selector="Border.bridge-rail">
    <Setter Property="Background" Value="{DynamicResource JkSurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JkBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="20,18" />
    <Setter Property="MinHeight" Value="96" />
  </Style>

  <Style Selector="Border.bridge-node">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource JkNeutralSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JkNeutralBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.bridge-node.info">
    <Setter Property="Background" Value="{DynamicResource JkInfoSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JkInfoBorderBrush}" />
  </Style>

  <Style Selector="Border.bridge-node.connected">
    <Setter Property="Background" Value="{DynamicResource JkSuccessSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JkSuccessBorderBrush}" />
  </Style>

  <Style Selector="Border.bridge-node.warning">
    <Setter Property="Background" Value="{DynamicResource JkWarningSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JkWarningBorderBrush}" />
  </Style>

  <Style Selector="Border.bridge-node.error">
    <Setter Property="Background" Value="{DynamicResource JkErrorSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JkErrorBorderBrush}" />
  </Style>

  <Style Selector="Border.rail-line">
    <Setter Property="Height" Value="2" />
    <Setter Property="Background" Value="{DynamicResource JkNeutralBorderBrush}" />
    <Setter Property="CornerRadius" Value="1" />
  </Style>

  <Style Selector="Border.rail-line.active">
    <Setter Property="Background" Value="{DynamicResource JkBridgeGradientBrush}" />
  </Style>

  <Style Selector="Border.rail-line.connected">
    <Setter Property="Background" Value="{DynamicResource JkSuccessBrush}" />
  </Style>

  <Style Selector="Border.rail-line.warning">
    <Setter Property="Background" Value="{DynamicResource JkWarningBrush}" />
  </Style>

  <Style Selector="Border.rail-line.error">
    <Setter Property="Background" Value="{DynamicResource JkErrorBrush}" />
  </Style>

  <!-- Inline issue surfaces -->
  <Style Selector="Border.issue-banner">
    <Setter Property="Background" Value="{DynamicResource JkInfoSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JkInfoBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,12" />
  </Style>

  <Style Selector="Border.issue-banner.warning">
    <Setter Property="Background" Value="{DynamicResource JkWarningSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JkWarningBorderBrush}" />
  </Style>

  <Style Selector="Border.issue-banner.error">
    <Setter Property="Background" Value="{DynamicResource JkErrorSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JkErrorBorderBrush}" />
  </Style>

  <Style Selector="Border.issue-banner.success">
    <Setter Property="Background" Value="{DynamicResource JkSuccessSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JkSuccessBorderBrush}" />
  </Style>

  <!-- Status pills: apply the same state class to the inner TextBlock. -->
  <Style Selector="Border.status-pill">
    <Setter Property="Background" Value="{DynamicResource JkNeutralSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JkNeutralBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="8,3" />
  </Style>

  <Style Selector="Border.status-pill.info">
    <Setter Property="Background" Value="{DynamicResource JkInfoSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JkInfoBorderBrush}" />
  </Style>

  <Style Selector="Border.status-pill.connected">
    <Setter Property="Background" Value="{DynamicResource JkSuccessSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JkSuccessBorderBrush}" />
  </Style>

  <Style Selector="Border.status-pill.warning">
    <Setter Property="Background" Value="{DynamicResource JkWarningSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JkWarningBorderBrush}" />
  </Style>

  <Style Selector="Border.status-pill.error">
    <Setter Property="Background" Value="{DynamicResource JkErrorSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JkErrorBorderBrush}" />
  </Style>

  <Style Selector="TextBlock.status-text">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource JkNeutralBrush}" />
  </Style>

  <Style Selector="TextBlock.status-text.info">
    <Setter Property="Foreground" Value="{DynamicResource JkInfoBrush}" />
  </Style>

  <Style Selector="TextBlock.status-text.connected">
    <Setter Property="Foreground" Value="{DynamicResource JkSuccessBrush}" />
  </Style>

  <Style Selector="TextBlock.status-text.warning">
    <Setter Property="Foreground" Value="{DynamicResource JkWarningBrush}" />
  </Style>

  <Style Selector="TextBlock.status-text.error">
    <Setter Property="Foreground" Value="{DynamicResource JkErrorBrush}" />
  </Style>

  <!-- Commands -->
  <Style Selector="Button.primary">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="MinWidth" Value="96" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="{DynamicResource JkIrisBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JkIrisBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource JkTextOnAccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.primary:pointerover">
    <Setter Property="Background" Value="{DynamicResource JkIrisHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JkIrisHoverBrush}" />
  </Style>

  <Style Selector="Button.primary:pressed">
    <Setter Property="Background" Value="{DynamicResource JkIrisPressedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JkIrisPressedBrush}" />
  </Style>

  <Style Selector="Button.primary:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource JkFocusBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="Button.primary:disabled">
    <Setter Property="Opacity" Value="0.48" />
  </Style>

  <Style Selector="Button.secondary">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="15,8" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="{DynamicResource JkSurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JkBorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource JkTextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.secondary:pointerover">
    <Setter Property="Background" Value="{DynamicResource JkSurfaceHoverBrush}" />
  </Style>

  <Style Selector="Button.secondary:pressed">
    <Setter Property="Background" Value="{DynamicResource JkSurfacePressedBrush}" />
  </Style>

  <Style Selector="Button.secondary:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource JkFocusBrush}" />
  </Style>

  <Style Selector="Button.secondary:disabled">
    <Setter Property="Opacity" Value="0.48" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="11,7" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource JkTextMutedBrush}" />
  </Style>

  <Style Selector="Button.ghost:pointerover">
    <Setter Property="Background" Value="{DynamicResource JkSurfaceHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource JkTextBrush}" />
  </Style>

  <Style Selector="Button.ghost:pressed">
    <Setter Property="Background" Value="{DynamicResource JkSurfacePressedBrush}" />
  </Style>

  <Style Selector="Button.ghost:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource JkFocusBrush}" />
  </Style>

  <Style Selector="Button.danger">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="{DynamicResource JkErrorBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JkErrorBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource JkTextOnAccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.danger:pointerover">
    <Setter Property="Background" Value="{DynamicResource JkErrorHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JkErrorHoverBrush}" />
  </Style>

  <Style Selector="Button.danger:pressed">
    <Setter Property="Background" Value="{DynamicResource JkErrorPressedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JkErrorPressedBrush}" />
  </Style>

  <Style Selector="Button.icon-button">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="MinWidth" Value="36" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource JkTextMutedBrush}" />
  </Style>

  <Style Selector="Button.icon-button:pointerover">
    <Setter Property="Background" Value="{DynamicResource JkSurfaceHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource JkTextBrush}" />
  </Style>

  <Style Selector="Button.icon-button:pressed">
    <Setter Property="Background" Value="{DynamicResource JkSurfacePressedBrush}" />
  </Style>

  <Style Selector="Button.icon-button:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource JkFocusBrush}" />
  </Style>

  <Style Selector="Button.service-open">
    <Setter Property="MinWidth" Value="72" />
  </Style>

  <!-- Forms -->
  <Style Selector="TextBox.field">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="{DynamicResource JkSurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JkBorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource JkTextBrush}" />
    <Setter Property="Padding" Value="10,8" />
  </Style>

  <Style Selector="TextBox.field:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource JkFocusBrush}" />
  </Style>

  <Style Selector="TextBox.field.technical">
    <Setter Property="FontFamily" Value="{DynamicResource JkTechnicalFontFamily}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="ComboBox.field">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="{DynamicResource JkSurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JkBorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource JkTextBrush}" />
  </Style>

  <Style Selector="ComboBox.field:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource JkFocusBrush}" />
  </Style>

  <Style Selector="NumericUpDown.field">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="{DynamicResource JkSurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JkBorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource JkTextBrush}" />
  </Style>

  <!-- Lists and diagnostics -->
  <Style Selector="ListBox.service-list">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="ListBoxItem.service-row">
    <Setter Property="MinHeight" Value="60" />
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Background" Value="{DynamicResource JkSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JkBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="ListBoxItem.service-row:pointerover">
    <Setter Property="Background" Value="{DynamicResource JkSurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JkBorderStrongBrush}" />
  </Style>

  <Style Selector="ListBoxItem.service-row:selected">
    <Setter Property="Background" Value="{DynamicResource JkIrisSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JkIrisBorderBrush}" />
  </Style>

  <Style Selector="Expander.diagnostic">
    <Setter Property="Background" Value="{DynamicResource JkSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JkBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="Margin" Value="0,0,0,10" />
  </Style>

  <Style Selector="Separator.quiet">
    <Setter Property="Background" Value="{DynamicResource JkDividerBrush}" />
    <Setter Property="Margin" Value="0,12" />
  </Style>

  <Style Selector="ProgressBar.bridge-progress">
    <Setter Property="Height" Value="3" />
    <Setter Property="Foreground" Value="{DynamicResource JkIrisBrush}" />
    <Setter Property="Background" Value="{DynamicResource JkNeutralSurfaceBrush}" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>

</Styles>
