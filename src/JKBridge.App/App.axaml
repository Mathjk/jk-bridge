<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="JKBridge.App.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://JKBridge/Styles/Colors.axaml" />
        <StyleInclude Source="avares://JKBridge/Styles/Controls.axaml" />
    </Application.Styles>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/jkbridge.ico"
                      ToolTipText="JK Bridge"
                      Clicked="TrayIcon_OnClicked">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="打开 JK Bridge" Click="ShowMenuItem_OnClick" />
                        <NativeMenuItem Header="连接 / 断开" Click="ToggleMenuItem_OnClick" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="打开 Overleaf" Click="OpenOverleafMenuItem_OnClick" />
                        <NativeMenuItem Header="打开 GPU Dashboard" Click="OpenGpuMenuItem_OnClick" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="诊断" Click="DiagnosticsMenuItem_OnClick" />
                        <NativeMenuItem Header="设置" Click="SettingsMenuItem_OnClick" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="退出" Click="ExitMenuItem_OnClick" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>
